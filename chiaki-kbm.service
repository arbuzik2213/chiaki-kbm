[Unit]
Description=chiaki-kbm: keyboard and mouse for PS5 Remote Play (chiaki-ng)
After=graphical-session.target
PartOf=graphical-session.target

[Service]
ExecStart=/usr/bin/sg input -c "/usr/bin/python3 %h/.local/share/chiaki-kbm/chiaki_kbm.py"
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
